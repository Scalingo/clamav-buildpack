#!/usr/bin/env bash
# usage: bin/compile <build_dir> <cache_dir> <env_dir>


cmnlib="$( readlink -f "$( dirname "${0}" )/../vendor/cmnlib.sh" )"
# shellcheck source=vendor/cmnlib.sh
source "${cmnlib}"

cmn::main::start "${0}" "${1}" "${2}" "${3}"

# -----------------------------------------------------------------------------

# Inventory file:
inventory="${buildpack_dir:?}/INVENTORY-${STACK:?}.tsv"

# This statement won't fail even if cmn::inventory::get_default were to fail.
version="${CLAMAV_VERSION:-$( cmn::inventory::get_default "${inventory}" )}"

if [[ -z "${version}" ]]; then
	cmn::main::fail 1 <<- EOM
		Unable to determine which version of ClamAV to deploy.
		It seems like there is no default version in the inventory file either,
		which isn't OK.

		Please:
		1. Set CLAMAV_VERSION environment variable to the desired value, and
		   try to redeploy. It should pass.
		2. Either reach out to our Support Team to let them know about this
		   situation, or file an issue in the buildpack repository:
		   https://github.com/Scalingo/clamav-buildpack/issues
		Thanks <3

		Aborting for now.
	EOM
fi

if ! archive_url="$( cmn::inventory::get_url "${inventory}" "${version}" )"
then
	cmn::main::fail 1 <<- EOM
		Unable to retrieve download URL for version ${version}".
		It seems like there's an issue with the buildpack inventory file.

		Please either reach out to our Support Team to let them know about this
		situation, or file an issue in the buildpack repository:
		https://github.com/Scalingo/clamav-buildpack/issues
		Thanks <3

		Aborting for now.
	EOM
fi


if ! archive_checksum="$( cmn::inventory::get_checksum "${inventory}" "${version}" )"
then
	cmn::main::fail 1 <<- EOM
		Unable to retrieve checksum for version ${version}".
		It seems like there's an issue with the buildpack inventory file.

		Please either reach out to our Support Team to let them know about this
		situation, or file an issue in the buildpack repository:
		https://github.com/Scalingo/clamav-buildpack/issues
		Thanks <3

		Aborting for now.
	EOM
fi

cache_file="${cache_dir:?}/clamav-${version}.tar.gz"
clamav_dir="${build_dir:?}/clamav"

# Where ClamAV configuration files are:
clamav_conf_dir="${clamav_dir}/conf"

# Where clamd's database is:
clamav_db_dir="${clamav_dir}/data"

cmn::output::info "Deploying ClamAV ${version}"

# -----------------------------------------------------------------------------

cmn::step::start "Installing prerequisites"

mkdir --parents -- "${build_dir:?}/.profile.d"
mkdir --parents -- "${clamav_db_dir}"
mkdir --parents -- "${clamav_conf_dir}"
mkdir --parents -- "${clamav_dir}/run"

# -----------------------------------------------------------------------------
# To keep compat with current version:
# - copy .profile.d scripts to clamav/bin.
# - ln -sfn /app/clamav/bin/<script>.sh /app/.profile.d/
# - how do we disable these links?

cmn::step::start "Installing ClamAV"

if [[ -f "${cache_file}" ]]; then
	# The archive doesn't exist in the cache.

	# Remove any existing .tar.gz file from the cache, as they are probably for
	# another version:
	cmn::task::start "Cleaning cache"
	rm --recursive --force -- "${cache_dir:?}"/clamav*.tar.gz
	cmn::task::finish

	# Download appropriate version:
	cmn::task::start "Downloading archive"
	if ! cmn::file::download "${archive_url}" "${cache_file}"; then
		cmn::main::fail 2 <<- EOM
			Unable to download ClamAV archive.
			Aborting.
		EOM
	fi
	cmn::task::finish
else
	# The archive is cached.
	cmn::output::info "Found matching file in cache."
fi

# From this point, we have an archive in cache.

# We always check the archive validity to prevent cache corruption and other
# issues
cmn::task::start "Checking archive validity"
if ! cmn::file::validate_checksum "${cache_file}" "${archive_checksum}"; then
	# File in cache doesn't seem valid,
	# remove it so a future run can be successful
	rm --force -- "${cache_file}"

	cmn::main::fail 2 <<- EOM
		The checksum for the archive file in the cache doesn't match what's
		expected.

		Here are the most common causes:

		- A networking issue occured, causing the downloaded file to be
		  incomplete or corrupt. Triggering a new deployment should force the
		  platform to download the archive again, and the deployment should
		  pass.

		- Upstream replaced the archive and its checksum, resulting in the same
		  version number having a different checksum. This could mean a
		  malicious threat tampered the source archive and its checksum.
		  Please check upstream for a potential explanation and make sure it's
		  still trustable.

		In all cases, the cached archive has been removed to force a new
		download during the next deployment attempt.

		Aborting.
	EOM
fi
cmn::task::finish

# From this point we have a valid file in cache.
#
cmn::task::start "Extracting"
mkdir --parents -- "${clamav_dir}"
tar --extract --file="${cache_file}" --directory="${clamav_dir}" \
	--strip-components=1
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Setting up"

cmn::task::start "Copying configuration templates"
for _conf in \
	"${buildpack_dir:?}/vendor/conf/clamd.conf.erb" \
	"${buildpack_dir:?}/vendor/conf/freshclam.conf.erb"
do
	cp -- "${_conf}" "${clamav_conf_dir}/" 2> /dev/null
done
cmn::task::finish

cmn::task::start "Copying profile.d script"
for _script in \
	"${buildpack_dir:?}/vendor/profile.d/010-clamav.sh"
do
	cp -- "${_script}" "${build_dir:?}/.profile.d/" 2> /dev/null
done
cmn::task::finish

cmn::task::start "Copying startup scripts"
for _script in \
	"${buildpack_dir:?}/vendor/start.sh"
do
	cp -- "${_script}" "${clamav_dir}/bin/" 2> /dev/null
done
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Initializing signature database"
#
# We use a timestamp file to determine if we should run freshclam or not
# during BUILD. This avoids hammering ClamAV's servers.
# If the timestamp file doesn't exist, or if it's older than 6 hours, we
# run freshclam.
# Else, we consider the cache as being recent enough, and we won't run
# freshclam during BUILD.
#

PATH="${PATH:+${PATH}:}${clamav_dir}/bin:${clamav_dir}/sbin"
export PATH

LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+${LD_LIBRARY_PATH}:}${clamav_dir}/lib"
export LD_LIBRARY_PATH

stamp_file="${cache_dir:?}/clamav-data/last-freshclam-check"
stamp_file_too_old="$( find "${stamp_file}" -mmin +360 -print 2> /dev/null )"

if [[ ! -f "${stamp_file}" ]] || [[ -n "${stamp_file_too_old}" ]]; then
	cmn::task::start "Building temporary configuration file for Freshclam"
	# We need a temporary config file for Freshclam to be able to run hereafter
	echo "DatabaseMirror ${CLAMAV_DATABASE_MIRROR:-"database.clamav.net"}" \
		> "${tmp_dir:?}/freshclam.conf"
	echo "DatabaseDirectory ${cache_dir:?}/clamav-data" \
		>> "${tmp_dir:?}/freshclam.conf"
	cmn::task::finish

	cmn::task::start "Downloading latest signature database"
	# Refresh the virus database
	# The source is specified in the conf file
	freshclam --foreground --config-file="${tmp_dir:?}/freshclam.conf" \
		2> /dev/null

	# Create or update $stamp_file modification time:
	touch "${stamp_file}"
	cmn::task::finish
else
	cmn::output::info <<- EOM
		Signature database in cache is recent enough (less than 6 hours old).
		Going on with it.
	EOM
fi

# Put the virus database in place:
cp --archive --force -- "${cache_dir:?}/clamav-data/." "${clamav_db_dir}/"
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::main::finish
